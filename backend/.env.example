# Copy this file to .env and fill in your own values.

# --- Database ---
# Local dev default (SQLite, zero setup, file created automatically):
DATABASE_URL=sqlite:///./b2world.db
# For Neon / production Postgres, use something like:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth / Security ---
# Generate a strong random string, e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=30

# --- Optional AI scoring (Module 3) ---
# If left empty, the app automatically falls back to a local keyword-matching
# ATS scorer, so resume screening still works with zero setup.
GEMINI_API_KEY=

# --- Optional email sending (forgot password / notifications) ---
# If left empty, reset links are printed to the backend console/log instead
# of being emailed, so forgot-password still works with zero setup.
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@b2world.local

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
